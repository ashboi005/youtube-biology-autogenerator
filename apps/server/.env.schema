# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Public URL of the web dashboard (used for B2 CORS + OAuth redirect back)
# @type=url @sensitive=false
WEB_URL=http://localhost:3001

# Scratch directory for renders (wiped on worker start)
# @sensitive=false
WORK_DIR=/tmp/ytbio-work

# --- Backblaze B2 (S3-compatible API) ---
# Public endpoint (appears in presigned URLs)
# @optional @type=url @sensitive=false
B2_ENDPOINT=
# @optional @sensitive=false
B2_REGION=
# @optional @sensitive=false
B2_BUCKET=
# Key *ID* is embedded in every presigned URL by design; B2_APP_KEY is the secret
# @optional @sensitive=false
B2_KEY_ID=
# @optional
B2_APP_KEY=

# --- YouTube OAuth ---
# OAuth client IDs are public by design (they appear in the consent URL)
# @optional @sensitive=false
GOOGLE_CLIENT_ID=
# @optional
GOOGLE_CLIENT_SECRET=
# @optional @type=url @sensitive=false
GOOGLE_REDIRECT_URI=
# 32-byte hex key (64 chars) used to encrypt the YouTube refresh token
# @optional @type=string(minLength=64, maxLength=64)
TOKEN_ENC_KEY=

# --- Merge Gateway (LLM) ---
# @optional
MERGE_GATEWAY_API_KEY=
# @optional @sensitive=false
MERGE_MODEL=openai/gpt-5.2

# Font for text overlays (Docker image default: DejaVu Sans Bold)
# @optional @sensitive=false
FONT_PATH=
