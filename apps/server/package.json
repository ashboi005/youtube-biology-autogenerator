{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@elysiajs/cors": "^1.4.2",
    "@sinclair/typebox": "^0.34.52",
    "@youtube-biology-autogenerator/auth": "workspace:*",
    "@youtube-biology-autogenerator/db": "workspace:*",
    "ai": "^7.0.113",
    "better-auth": "catalog:",
    "elysia": "^1.4.30",
    "googleapis": "^182.0.0",
    "merge-gateway-ai-sdk-provider": "^0.3.0",
    "pg-boss": "^12.34.0",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@youtube-biology-autogenerator/config": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
